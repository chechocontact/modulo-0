; Vintage Maker - Windows installer (Inno Setup 6).
; Generated by CMake (configure_file) from installer/VintageMaker.iss.in: the version comes from
; the project() version in CMakeLists.txt, so the installer, the plugin and the Windows file
; properties always agree.
;
; Build:  ISCC.exe /DVst3Dir="<path to>\Vintage Maker.vst3" VintageMaker.iss
; The VST3 is a folder (bundle) built by the Release configuration.

#ifndef Vst3Dir
  #error Pass the VST3 bundle folder: /DVst3Dir="...\\Vintage Maker.vst3"
#endif

#define MyAppName      "Vintage Maker"
#define MyAppVersion   "@PROJECT_VERSION@"
#define MyAppDisplay   "@VM_VERSION_DISPLAY@"
#define MyAppPublisher "Vintage Maker"

[Setup]
; Never change AppId: it is how Windows recognises an update of the same product.
AppId={{E9231DE5-655C-47AD-B8AE-D24FEBA0EB43}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppDisplay}
AppPublisher={#MyAppPublisher}
VersionInfoVersion={#MyAppVersion}.0
VersionInfoProductName={#MyAppName}
VersionInfoProductVersion={#MyAppVersion}
VersionInfoDescription={#MyAppName} {#MyAppDisplay} installer
VersionInfoCopyright=Copyright (c) 2026 {#MyAppPublisher}

; The VST3 goes to the standard folder; the wizard does not ask for a folder.
DefaultDirName={commoncf64}\VST3
DisableDirPage=yes
DisableProgramGroupPage=yes
; The uninstaller must not sit inside the VST3 folder (DAWs scan it).
UninstallFilesDir={autopf}\Vintage Maker
UninstallDisplayName={#MyAppName} {#MyAppDisplay} (VST3)

PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0

OutputDir={#SourcePath}output
OutputBaseFilename=VintageMaker-{#MyAppVersion}-Setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ShowLanguageDialog=auto
CloseApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Files]
Source: "{#Vst3Dir}\*"; DestDir: "{commoncf64}\VST3\Vintage Maker.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs

[Dirs]
; The folder of the user presets. It is never removed: custom presets survive
; updates, reinstalls and uninstalling. (The plugin also creates it on the first save.)
Name: "{userappdata}\Vintage Maker\Presets"; Flags: uninsneveruninstall

; The factory presets are built into the plugin, so there is nothing else to copy. Uninstalling
; removes only the files installed above and leaves the user presets and every third-party file alone.
